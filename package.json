{
  "name": "currency-telegram-bot",
  "version": "1.0.0",
  "description": "Telegram bot that returns currency exchange rates",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/src/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x"
  },
  "packageManager": "pnpm@10.34.5"
}
